{
  "name": "hermes-tripo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tripo 3D viewer for Hermes Desktop: inline transcript cards, recent generations and a credit chip, rendered with three.js.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "esbuild src/plugin.tsx --bundle --format=esm --platform=browser --jsx=automatic --minify --legal-comments=eof --external:@hermes/plugin-sdk --external:react --external:react/jsx-runtime --outfile=desktop/plugin.js"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/three": "0.180.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.2"
  }
}
